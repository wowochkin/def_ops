{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:def-ops:kshvi:admin-contracts:1",
  "schemaVersion": 1,
  "title": "Административные контракты КШВИ",
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ConfigVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "kind", "version", "sha256", "content", "testReport", "status", "createdAt"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["DOCUMENTS", "SCALE", "COMMUNICATIONS", "WEATHER", "MODEL", "ASSESSMENT"] },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "content": true,
        "source": { "type": "string", "minLength": 1 },
        "assumption": { "type": "string", "minLength": 1 },
        "testReport": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PASSED", "FAILED"] } } },
        "status": { "enum": ["IMPORTED", "APPROVED"] },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "anyOf": [{ "required": ["source"] }, { "required": ["assumption"] }]
    },
    "RetentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "activeDays", "archiveDays", "backupDays", "auditDays", "allowedMedia", "responsibleUserIds"],
      "properties": {
        "organizationId": { "type": "string" },
        "activeDays": { "type": "integer", "minimum": 1 },
        "archiveDays": { "type": "integer", "minimum": 1 },
        "backupDays": { "type": "integer", "minimum": 1 },
        "auditDays": { "type": "integer", "minimum": 1 },
        "allowedMedia": { "type": "array", "items": { "type": "string" } },
        "responsibleUserIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "DeletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exerciseId", "organizationId", "requestedBy", "confirmedBy", "requestedAt", "executeAfter", "status", "jobId"],
      "properties": {
        "id": { "type": "string" }, "exerciseId": { "type": "string" }, "organizationId": { "type": "string" },
        "requestedBy": { "type": "string" }, "confirmedBy": { "type": ["string", "null"] },
        "requestedAt": { "type": "string", "format": "date-time" }, "executeAfter": { "type": "string", "format": "date-time" },
        "status": { "enum": ["LOCKED", "SCHEDULED", "EXECUTED"] }, "jobId": { "type": ["string", "null"] }
      }
    },
    "BackupFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "sha256", "size", "offset", "assembledSha256", "assembledSize"],
      "properties": {
        "name": { "type": "string" },
        "category": { "enum": ["SCENARIO", "ENVIRONMENT", "ASSIGNMENTS", "JOURNAL", "SNAPSHOT"] },
        "sha256": { "$ref": "#/definitions/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "assembledSha256": { "$ref": "#/definitions/sha256" },
        "assembledSize": { "type": "integer", "minimum": 0 }
      }
    },
    "BackupManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "instanceId", "kind", "baseBackupId", "createdAt", "lastSequence", "versions", "files"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "instanceId": { "type": "string" },
        "kind": { "enum": ["FULL", "INCREMENTAL"] }, "baseBackupId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }, "lastSequence": { "type": "integer", "minimum": 0 },
        "versions": { "type": "object", "required": ["schema", "reducer"], "properties": { "schema": { "type": "string" }, "reducer": { "type": "integer" } } },
        "files": { "type": "array", "items": { "$ref": "#/definitions/BackupFile" } }
      }
    },
    "SecurityAuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "eventId", "occurredAt", "actorId", "organizationId", "action", "outcome", "correlationId", "prevHash", "hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 }, "eventId": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" }, "actorId": { "type": "string" },
        "organizationId": { "type": "string" }, "action": { "type": "string" }, "outcome": { "enum": ["ALLOWED", "DENIED"] },
        "correlationId": { "type": "string" }, "resourceType": { "type": "string" }, "resourceId": { "type": "string" },
        "prevHash": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] }, "hash": { "$ref": "#/definitions/sha256" }
      }
    },
    "OperationsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "readiness", "generatedAt", "services", "connections", "queues", "latencyMs", "storage", "backups", "clock", "versions", "errors", "alerts"],
      "properties": {
        "health": { "enum": ["HEALTHY", "DEGRADED", "DOWN"] },
        "readiness": { "type": "object", "required": ["ready", "reasons"], "properties": { "ready": { "type": "boolean" }, "reasons": { "type": "array", "items": { "type": "string" } } } },
        "generatedAt": { "type": "string", "format": "date-time" },
        "services": { "type": "object" }, "connections": { "type": "object" }, "queues": { "type": "object" },
        "latencyMs": { "type": "object" }, "storage": { "type": "object" }, "backups": { "type": "object" },
        "clock": { "type": "object" }, "versions": { "type": "object", "additionalProperties": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "object" } }, "alerts": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
