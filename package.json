{
  "name": "def-ops",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Тактическая карта: движок военно-исторических знаков, редактор и микросервисы",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @def-ops/editor",
    "dev:services": "node scripts/dev-services.mjs",
    "build": "npm run build -w @def-ops/editor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:voice": "npm run test -w @def-ops/voice",
    "start": "npm run build && STATIC_DIR=apps/editor/dist node scripts/dev-services.mjs",
    "docs:library": "tsx scripts/gen-library-doc.ts",
    "docs:pdf": "node scripts/gen-library-pdf.mjs",
    "llm:eval": "tsx services/staff/src/eval/cli.ts",
    "llm:quick": "tsx services/staff/src/eval/quick.ts",
    "llm:umpire": "tsx services/staff/src/eval/umpire-ab.ts",
    "llm:mock": "tsx services/staff/src/live/mock-cli.ts",
    "sim:history": "tsx packages/sim/tools/run/history.ts",
    "sim:scenario": "tsx packages/sim/tools/scenario/build_scenario.ts",
    "sim:sectors": "tsx packages/sim/tools/scenario/build_sectors.ts",
    "kb:seed": "tsx packages/knowledge/tools/build_seed.ts",
    "model:index": "tsx packages/knowledge/tools/build_model_index.ts",
    "theatre:sample": "node --no-warnings --experimental-strip-types packages/sim/tools/theatre/raster_sample.ts",
    "sim:norms": "tsx packages/sim/tools/run/norms.ts",
    "sim:census": "tsx packages/sim/tools/agents/census.ts",
    "agents:test": "cargo test --release -p agents-core",
    "agents:bench": "cargo run --release -q --bin agents-bench --",
    "agents:app": "node scripts/agents-prepare.mjs && npm run tauri -w @def-ops/agents-app -- dev",
    "agents:app:build": "npm run tauri -w @def-ops/agents-app -- build",
    "desktop:app": "node apps/desktop/server/voice-env.mjs && node scripts/desktop-bundle.mjs --node-only && npm run tauri -w @def-ops/desktop -- dev",
    "voice:setup": "bash services/voice/setup.sh",
    "desktop:build": "npm run tauri -w @def-ops/desktop -- build",
    "agents:web": "node scripts/agents-prepare.mjs && npm run dev -w @def-ops/agents-app",
    "agents:seelow-data": "npm run -s sim:census -- --json evals-out/census/census.json && tsx packages/sim/tools/agents/build-seelow.ts",
    "agents:seelow": "cargo run --release -q --bin agents-run -- --scenario packages/sim/data/scenarios/agents/seelow-1945.json --out evals-out/agents/seelow",
    "agents:vistula-data": "tsx packages/sim/tools/agents/build-vistula.ts",
    "agents:berlin-data": "npm run -s sim:census -- --json evals-out/census/census.json && tsx packages/sim/tools/agents/build-berlin.ts",
    "agents:berlin": "cargo run --release -q --bin agents-run -- --scenario packages/sim/data/scenarios/agents/berlin-1945.json --out evals-out/agents/berlin",
    "agents:berlin:variants": "node scripts/agents-variants.mjs berlin",
    "sim:geocode-tsamo": "tsx packages/sim/tools/agents/geocode-tsamo.ts",
    "sim:calibrate": "tsx packages/sim/tools/run/calibrate.ts",
    "sim:sensitivity": "tsx packages/sim/tools/run/sensitivity.ts",
    "sim:data-sensitivity": "tsx packages/sim/tools/run/data-sensitivity.ts",
    "sim:regimes": "tsx packages/sim/tools/run/calibrate-regimes.ts --compare",
    "sim:calibrate-regimes": "tsx packages/sim/tools/run/calibrate-regimes.ts",
    "theatre:setup": "python3 -m venv .venv && .venv/bin/pip install -r packages/sim/tools/theatre/requirements.txt",
    "theatre:height": "sh -c '.venv/bin/python packages/sim/tools/theatre/build_theatre.py packages/sim/data/theatres/src/$0.recipe.json --height-only packages/sim/data/theatres/$0.json'",
    "theatre:overlay": "node --no-warnings --experimental-strip-types packages/sim/tools/theatre/raster_overlay.ts",
    "sim:demo": "node scripts/sim-demo.mjs",
    "docs:system": "node scripts/gen-doc.mjs",
    "docs:guide": "node scripts/gen-doc.mjs docs/guide.md docs/guide.pdf"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
