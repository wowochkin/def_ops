{
  "name": "def-ops",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Тактическая карта: движок военно-исторических знаков, редактор и микросервисы",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @def-ops/editor",
    "dev:services": "node scripts/dev-services.mjs",
    "build": "npm run build -w @def-ops/editor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && STATIC_DIR=apps/editor/dist node scripts/dev-services.mjs",
    "docs:library": "tsx scripts/gen-library-doc.ts",
    "docs:pdf": "node scripts/gen-library-pdf.mjs",
    "llm:eval": "tsx services/staff/src/eval/cli.ts",
    "llm:quick": "tsx services/staff/src/eval/quick.ts",
    "llm:umpire": "tsx services/staff/src/eval/umpire-ab.ts",
    "llm:mock": "tsx services/staff/src/live/mock-cli.ts",
    "sim:history": "tsx packages/sim/tools/run/history.ts",
    "sim:scenario": "tsx packages/sim/tools/scenario/build_scenario.ts",
    "sim:sectors": "tsx packages/sim/tools/scenario/build_sectors.ts",
    "kb:seed": "tsx packages/knowledge/tools/build_seed.ts",
    "theatre:sample": "node --no-warnings --experimental-strip-types packages/sim/tools/theatre/raster_sample.ts",
    "sim:norms": "tsx packages/sim/tools/run/norms.ts",
    "sim:calibrate": "tsx packages/sim/tools/run/calibrate.ts",
    "sim:sensitivity": "tsx packages/sim/tools/run/sensitivity.ts",
    "theatre:setup": "python3 -m venv .venv && .venv/bin/pip install -r packages/sim/tools/theatre/requirements.txt",
    "theatre:height": "sh -c '.venv/bin/python packages/sim/tools/theatre/build_theatre.py packages/sim/data/theatres/src/$0.recipe.json --height-only packages/sim/data/theatres/$0.json'",
    "theatre:overlay": "node --no-warnings --experimental-strip-types packages/sim/tools/theatre/raster_overlay.ts",
    "sim:demo": "node scripts/sim-demo.mjs",
    "docs:system": "node scripts/gen-doc.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
