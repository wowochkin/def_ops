{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окна приложения (главное и окна выставочного стенда expo-*): страница запуска и редактор с локального шлюза (127.0.0.1) или vite в разработке; команды агентной модели",
  "windows": [
    "main",
    "expo-*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-run-scenario",
    "allow-read-text",
    "allow-list-models",
    "allow-llm-chat-stream",
    "allow-llm-cancel",
    "allow-probe-parallel",
    "allow-game-start",
    "allow-game-turn",
    "allow-game-directive",
    "allow-game-historical",
    "allow-game-take",
    "allow-game-release",
    "allow-game-permit",
    "allow-game-rewind",
    "allow-game-variants",
    "allow-game-stop",
    "allow-expo-settings-read",
    "allow-expo-settings-write",
    "allow-expo-monitors",
    "allow-expo-open",
    "allow-expo-close-all",
    "allow-expo-set-guard",
    "allow-expo-log",
    "allow-expo-stats-add",
    "allow-expo-stats-today"
  ]
}
