{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Тактическая карта",
  "version": "0.1.0",
  "identifier": "ru.defops.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": {
      "script": "npm run dev -w @def-ops/editor",
      "wait": false
    },
    "beforeBuildCommand": "node ../../scripts/desktop-bundle.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Тактическая карта",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server/": "server/",
      "../../editor/dist/": "editor/",
      "../../../packages/sim/data/": "data/packages/sim/data/"
    }
  }
}
